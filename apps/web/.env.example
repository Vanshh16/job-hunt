# Postgres (Neon / Supabase). DIRECT_URL = non-pooled connection (can be the same as DATABASE_URL).
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# Dashboard login password and session-signing secret (any long random string)
APP_PASSWORD="change-me"
AUTH_SECRET="generate-a-long-random-string"

# Shared secret used by the Chrome extension and Telegram worker (Authorization: Bearer ...)
API_TOKEN="generate-another-long-random-string"

# Vercel Cron sends this as a Bearer token to /api/cron/daily
CRON_SECRET="generate-a-third-random-string"

# Google Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"
# Optional: none | low | medium | high (lower = faster)
GEMINI_REASONING_EFFORT=""

# Telegram bot used to notify YOU (create via @BotFather). Chat ID can be detected in Settings.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Public URL of the dashboard (used in notification links)
APP_URL="http://localhost:3000"
