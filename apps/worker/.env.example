# From https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Printed by `npm run login` (keep secret: it is a logged-in session of your account)
TELEGRAM_SESSION=
# Optional: initial groups to read (ids from `npm run chats` or @usernames). After the first sync,
# pick groups on the dashboard's Setup page instead — that selection takes over.
TELEGRAM_GROUPS=

# Your dashboard
APP_URL=https://your-app.vercel.app
API_TOKEN=

# On the very first run, only look at this many recent messages per group
INITIAL_BACKFILL=30
